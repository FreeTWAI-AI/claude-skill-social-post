{
  "exclude": [".git/**", "__pycache__/**", "*.pyc"],
  "thresholds": {
    "skill_warning": 200,
    "skill_severe": 400,
    "reference_warning": 400,
    "reference_severe": 800,
    "code_warning": 500,
    "code_severe": 1000
  },
  "length_exceptions": [],
  "navigation_exceptions": ["references/rules/R*.md", "references/formulas/F*.md", "references/cases/case-*.md"],
  "id_definition_scopes": {
    "R": ["references/rules/R*.md"],
    "F": ["references/formulas/F*.md"],
    "CASE": ["references/cases/case-*.md"]
  },
  "range_claim_scopes": {
    "R": ["references/rules.md"],
    "F": [],
    "CASE": ["references/case_studies.md"]
  },
  "sync": {"public_root": null, "ignore": []},
  "privacy": {"tokens": [], "patterns": ["C:[/\\\\]Users[/\\\\]"]},
  "architecture": {
    "function_warning_lines": 80,
    "function_severe_lines": 160,
    "layers": [
      {"name": "domain", "patterns": ["scripts/social_validation.py", "scripts/comment_identity.py", "scripts/comment_authorization.py", "scripts/comment_domain.py", "scripts/comment_policy.py"], "may_depend_on": []},
      {"name": "storage", "patterns": ["scripts/social_store.py", "scripts/comment_store.py"], "may_depend_on": []},
      {"name": "application", "patterns": ["scripts/social_data.py", "scripts/comment_state.py"], "may_depend_on": ["domain", "storage"]},
      {"name": "cli", "patterns": ["scripts/log_outcome.py", "scripts/comment_assistant.py", "scripts/comment_cli_support.py"], "may_depend_on": ["application", "domain", "storage"]},
      {"name": "test", "patterns": ["scripts/self_test.py", "scripts/comment_self_test.py", "scripts/comment_test_*.py"], "may_depend_on": ["application", "domain", "storage", "cli", "tools"]},
      {"name": "tools", "patterns": ["scripts/build_rule_registry.py", "scripts/split_*.py"], "may_depend_on": []}
    ],
    "required_dependencies": [
      {"source": "scripts/log_outcome.py", "target": "scripts/social_store.py"},
      {"source": "scripts/log_outcome.py", "target": "scripts/social_data.py"},
      {"source": "scripts/social_data.py", "target": "scripts/social_validation.py"},
      {"source": "scripts/social_data.py", "target": "scripts/social_store.py"},
      {"source": "scripts/comment_assistant.py", "target": "scripts/comment_domain.py"},
      {"source": "scripts/comment_assistant.py", "target": "scripts/comment_policy.py"},
      {"source": "scripts/comment_assistant.py", "target": "scripts/comment_cli_support.py"},
      {"source": "scripts/comment_cli_support.py", "target": "scripts/comment_state.py"},
      {"source": "scripts/comment_cli_support.py", "target": "scripts/comment_store.py"},
      {"source": "scripts/comment_domain.py", "target": "scripts/comment_authorization.py"},
      {"source": "scripts/comment_domain.py", "target": "scripts/comment_identity.py"},
      {"source": "scripts/comment_authorization.py", "target": "scripts/comment_identity.py"},
      {"source": "scripts/comment_state.py", "target": "scripts/comment_domain.py"},
      {"source": "scripts/comment_state.py", "target": "scripts/comment_policy.py"},
      {"source": "scripts/comment_store.py", "target": "scripts/social_store.py"}
    ]
  }
}
